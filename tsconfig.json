{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "outDir": "dist"
  },
  "include": ["api", "lib", "tests"],
  "exclude": ["node_modules", ".vercel"]
}
